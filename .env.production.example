# 生产环境配置样例：复制为 .env.production 并填写真实值后
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
# 注意：主机名用 compose 服务名（postgres/redis/minio），端口用容器内端口。

# ===== 应用 =====
APP_ENV=prod
LOG_LEVEL=INFO
# 非 local 环境强制：JWT_SECRET 必须覆盖默认且长度≥32
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=720
# ===== 内部服务身份（迁移期双实现，配置互斥）=====
# INTERNAL_JWT_ENABLED=false：legacy app.core.internal_token（ES256）。
# INTERNAL_JWT_ENABLED=true：目标 app.platform.service_identity（RS256）。
# 两套实现共用密钥/签发者字段，但私钥算法不可混用；一次只启用一套。
INTERNAL_JWT_ENABLED=false
INTERNAL_JWT_ISSUER=
INTERNAL_JWT_AUDIENCE=
INTERNAL_JWT_SERVICE_ID=
# 仅留空占位；由部署 Secret 注入，绝不提交真实 PEM。
# legacy=false 时填 EC（ES256）密钥；service identity=true 时填 RSA（RS256）密钥。
INTERNAL_JWT_PRIVATE_KEY=
INTERNAL_JWT_PUBLIC_KEY=
INTERNAL_JWT_EXPIRE_SECONDS=300
INTERNAL_JWT_TTL_SECONDS=300
# Uvicorn worker 数（按 CPU 核心；注意内存态熔断器为每-worker，见 docs/09）
WEB_CONCURRENCY=2
# 对外 HTTP 端口（Nginx）
HTTP_PORT=80

# ===== 基础设施凭证（compose 起容器 + backend 连接共用同一组）=====
POSTGRES_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ===== 连接串（主机名=内网服务名；DATABASE_URL 里的密码需手填为上面 POSTGRES_PASSWORD 的实际值）=====
DATABASE_URL=postgresql+asyncpg://postgres:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/youdoo
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=youdoo

# ===== 大模型（国产为主）=====
# 首次部署：若填了 DEEPSEEK_API_KEY，backend 首启会自动种 2 张 AI 卡片
# （daily=deepseek-chat / reasoning=deepseek-reasoner），开箱即 AI 可用。
# 之后可在「AI 配置」页增改卡片（推荐用 UI 管理，不再依赖此处）。
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
LLM_DAILY_TOKEN_BUDGET=0
# 预算硬闸（H2.2）：true 时超日预算直接拒绝新 LLM 调用（默认 false=仅告警）
LLM_BUDGET_HARD_LIMIT=false
# LLM 调用护栏（H2.1）：单候选请求超时(秒)/SDK重试/failover尝试上限/整链总超时(秒)
LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=1
LLM_FAILOVER_MAX_ATTEMPTS=3
LLM_TOTAL_TIMEOUT=120

# ===== Embedding（默认通义 1024 维；换 bge-m3 填端点/模型/密钥）=====
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_API_KEY=

# ===== 混合检索 Rerank（可选，默认关）=====
# 端点/模型有迁移种子默认值（SiliconFlow bge-reranker-v2-m3），密钥留空。
# 启用方式：登录后在「系统配置」页填 rerank_api_key + 开 retrieval_rerank_enabled 开关，
# 无需在此填（rerank/AI卡片等密钥走 UI 系统配置页，不入 .env）。

# ===== 飞书 =====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_NOTIFY_ENABLED=false
FEISHU_OPS_CHAT_ID=

# ===== ThinkingData（可选）=====
TD_BASE_URL=
TD_API_SECRET=

# ===== Lodge resource-server（由部署平台注入；不得写真实 token/Secret）=====
LODGE_IDENTITY_ENABLED=false
LODGE_ISSUER=
LODGE_JWKS_URL=
LODGE_AUDIENCE=youdoogo
LODGE_STATUS_URL=
# 仅留空占位；部署时由 Secret 注入，绝不写入此文件或转发浏览器 target token。
LODGE_STATUS_SERVICE_TOKEN=
LODGE_HTTP_TIMEOUT_SECONDS=3
LODGE_JWKS_CACHE_TTL_SECONDS=300
LODGE_STATUS_CACHE_TTL_SECONDS=60
LODGE_STATUS_CACHE_MAX_ENTRIES=10000
LODGE_RESPONSE_MAX_BYTES=65536
