apiVersion: v1
kind: Service
metadata:
  name: youdoogo-backend
  namespace: __NAMESPACE__
  labels:
    app.kubernetes.io/name: youdoogo-backend
    app.kubernetes.io/part-of: youdoogo
spec:
  selector:
    app.kubernetes.io/name: youdoogo-backend
  ports:
    - name: http
      port: 8000
      targetPort: http
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: youdoogo-backend
  namespace: __NAMESPACE__
  labels:
    app.kubernetes.io/name: youdoogo-backend
    app.kubernetes.io/part-of: youdoogo
spec:
  replicas: 2
  revisionHistoryLimit: 3
  strategy:
    type: RollingUpdate
    rollingUpdate:
      # The production CCE cluster is currently at its pod ceiling. Replace one
      # ready replica at a time rather than creating an additional surge pod.
      maxUnavailable: 1
      maxSurge: 0
  selector:
    matchLabels:
      app.kubernetes.io/name: youdoogo-backend
  template:
    metadata:
      labels:
        app.kubernetes.io/name: youdoogo-backend
        app.kubernetes.io/part-of: youdoogo
        app.kubernetes.io/version: __IMAGE_TAG__
    spec:
      terminationGracePeriodSeconds: 30
      imagePullSecrets:
        - name: __IMAGE_PULL_SECRET__
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: backend
          image: __BACKEND_IMAGE__
          imagePullPolicy: Always
          args: ["serve"]
          envFrom:
            - configMapRef:
                name: __RUNTIME_CONFIGMAP_NAME__
            - secretRef:
                name: __RUNTIME_SECRET_NAME__
          env:
            - name: WEB_CONCURRENCY
              value: "2"
            - name: TMPDIR
              value: /tmp
          ports:
            - name: http
              containerPort: 8000
          startupProbe:
            httpGet:
              path: /api/v1/health
              port: http
            periodSeconds: 5
            timeoutSeconds: 3
            failureThreshold: 30
          readinessProbe:
            httpGet:
              path: /api/v1/health
              port: http
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /api/v1/health
              port: http
            periodSeconds: 20
            timeoutSeconds: 3
            failureThreshold: 3
          resources:
            requests:
              cpu: 200m
              memory: 512Mi
            limits:
              cpu: "2"
              memory: 2Gi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: tmp
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: youdoogo-frontend
  namespace: __NAMESPACE__
  labels:
    app.kubernetes.io/name: youdoogo-frontend
    app.kubernetes.io/part-of: youdoogo
spec:
  selector:
    app.kubernetes.io/name: youdoogo-frontend
  ports:
    - name: http
      port: 80
      targetPort: http
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: youdoogo-frontend
  namespace: __NAMESPACE__
  labels:
    app.kubernetes.io/name: youdoogo-frontend
    app.kubernetes.io/part-of: youdoogo
spec:
  replicas: 2
  revisionHistoryLimit: 3
  strategy:
    type: RollingUpdate
    rollingUpdate:
      # The production CCE cluster is currently at its pod ceiling. Replace one
      # ready replica at a time rather than creating an additional surge pod.
      maxUnavailable: 1
      maxSurge: 0
  selector:
    matchLabels:
      app.kubernetes.io/name: youdoogo-frontend
  template:
    metadata:
      labels:
        app.kubernetes.io/name: youdoogo-frontend
        app.kubernetes.io/part-of: youdoogo
        app.kubernetes.io/version: __IMAGE_TAG__
    spec:
      terminationGracePeriodSeconds: 30
      imagePullSecrets:
        - name: __IMAGE_PULL_SECRET__
      securityContext:
        runAsNonRoot: true
        runAsUser: 101
        runAsGroup: 101
        fsGroup: 101
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: frontend
          image: __FRONTEND_IMAGE__
          imagePullPolicy: Always
          env:
            - name: BACKEND_HOST
              value: youdoogo-backend
            - name: BACKEND_PORT
              value: "8000"
          ports:
            - name: http
              containerPort: 8080
          startupProbe:
            httpGet:
              path: /nginx-health
              port: http
            periodSeconds: 5
            timeoutSeconds: 3
            failureThreshold: 12
          readinessProbe:
            httpGet:
              path: /nginx-health
              port: http
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /nginx-health
              port: http
            periodSeconds: 20
            timeoutSeconds: 3
            failureThreshold: 3
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 500m
              memory: 256Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: nginx-conf
              mountPath: /etc/nginx/conf.d
            - name: nginx-cache
              mountPath: /var/cache/nginx
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: nginx-conf
          emptyDir: {}
        - name: nginx-cache
          emptyDir: {}
        - name: tmp
          emptyDir: {}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: youdoogo
  namespace: __NAMESPACE__
  labels:
    app.kubernetes.io/name: youdoogo
    app.kubernetes.io/part-of: youdoogo
  # Verified against working independent-host CCE Ingresses on the shared
  # production ELB. Keep this listener binding aligned with its owner.
  annotations:
    kubernetes.io/elb.class: performance
    kubernetes.io/elb.id: abab7533-a1c6-4138-a4bc-59d53e3446e2
    kubernetes.io/elb.listen-ports: '[{"HTTP":80},{"HTTPS":443}]'
    kubernetes.io/elb.listener-master-ingress: nexus-prod/nexus-studio
    kubernetes.io/elb.tls-certificate-ids: 56de20421757445ea53f5af51ecb4e10
spec:
  ingressClassName: __INGRESS_CLASS_NAME__
  rules:
    - host: ai.youdoogo.com
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: youdoogo-frontend
                port:
                  number: 80
