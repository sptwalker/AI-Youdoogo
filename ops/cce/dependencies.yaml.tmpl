# Dedicated YOUDOOGO dependencies. Values are non-secret; credentials are created by
# scripts/ci/bootstrap-runtime.sh and never belong in this manifest or GitLab variables.
apiVersion: v1
kind: ConfigMap
metadata:
  name: youdoogo-runtime-config
  namespace: __NAMESPACE__
  labels:
    app.kubernetes.io/part-of: youdoogo
data:
  APP_ENV: production
  LOG_LEVEL: INFO
  MINIO_ENDPOINT: youdoogo-minio:9000
  MINIO_BUCKET: youdoogo
---
apiVersion: v1
kind: Service
metadata:
  name: youdoogo-postgres
  namespace: __NAMESPACE__
  labels:
    app.kubernetes.io/name: youdoogo-postgres
    app.kubernetes.io/part-of: youdoogo
spec:
  selector:
    app.kubernetes.io/name: youdoogo-postgres
  ports:
    - name: postgres
      port: 5432
      targetPort: postgres
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: youdoogo-postgres
  namespace: __NAMESPACE__
  labels:
    app.kubernetes.io/name: youdoogo-postgres
    app.kubernetes.io/part-of: youdoogo
spec:
  serviceName: youdoogo-postgres
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: youdoogo-postgres
  template:
    metadata:
      labels:
        app.kubernetes.io/name: youdoogo-postgres
        app.kubernetes.io/part-of: youdoogo
    spec:
      terminationGracePeriodSeconds: 60
      containers:
        - name: postgres
          image: timescale/timescaledb-ha:pg16
          imagePullPolicy: IfNotPresent
          env:
            - name: POSTGRES_DB
              value: youdoogo
            - name: POSTGRES_USER
              value: youdoogo
            - name: POSTGRES_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: youdoogo-runtime
                  key: POSTGRES_PASSWORD
            - name: PGDATA
              value: /home/postgres/pgdata/data
          ports:
            - name: postgres
              containerPort: 5432
          readinessProbe:
            exec:
              command: ["sh", "-ec", "pg_isready -U youdoogo -d youdoogo"]
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 12
          livenessProbe:
            exec:
              command: ["sh", "-ec", "pg_isready -U youdoogo -d youdoogo"]
            periodSeconds: 20
            timeoutSeconds: 5
            failureThreshold: 3
          resources:
            requests: {cpu: 250m, memory: 1Gi}
            limits: {cpu: "2", memory: 4Gi}
          volumeMounts:
            - name: data
              mountPath: /home/postgres/pgdata
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        accessModes: ["ReadWriteOnce"]
        storageClassName: csi-disk
        resources:
          requests:
            storage: 20Gi
---
apiVersion: v1
kind: Service
metadata:
  name: youdoogo-redis
  namespace: __NAMESPACE__
  labels:
    app.kubernetes.io/name: youdoogo-redis
    app.kubernetes.io/part-of: youdoogo
spec:
  selector:
    app.kubernetes.io/name: youdoogo-redis
  ports:
    - name: redis
      port: 6379
      targetPort: redis
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: youdoogo-redis
  namespace: __NAMESPACE__
  labels:
    app.kubernetes.io/name: youdoogo-redis
    app.kubernetes.io/part-of: youdoogo
spec:
  serviceName: youdoogo-redis
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: youdoogo-redis
  template:
    metadata:
      labels:
        app.kubernetes.io/name: youdoogo-redis
        app.kubernetes.io/part-of: youdoogo
    spec:
      terminationGracePeriodSeconds: 30
      containers:
        - name: redis
          image: redis:7-alpine
          imagePullPolicy: IfNotPresent
          args: ["redis-server", "--appendonly", "yes"]
          ports:
            - name: redis
              containerPort: 6379
          readinessProbe:
            exec:
              command: ["redis-cli", "ping"]
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 12
          livenessProbe:
            exec:
              command: ["redis-cli", "ping"]
            periodSeconds: 20
            timeoutSeconds: 3
            failureThreshold: 3
          resources:
            requests: {cpu: 100m, memory: 256Mi}
            limits: {cpu: "1", memory: 1Gi}
          volumeMounts:
            - name: data
              mountPath: /data
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        accessModes: ["ReadWriteOnce"]
        storageClassName: csi-disk
        resources:
          requests:
            storage: 5Gi
---
apiVersion: v1
kind: Service
metadata:
  name: youdoogo-minio
  namespace: __NAMESPACE__
  labels:
    app.kubernetes.io/name: youdoogo-minio
    app.kubernetes.io/part-of: youdoogo
spec:
  selector:
    app.kubernetes.io/name: youdoogo-minio
  ports:
    - name: api
      port: 9000
      targetPort: api
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: youdoogo-minio
  namespace: __NAMESPACE__
  labels:
    app.kubernetes.io/name: youdoogo-minio
    app.kubernetes.io/part-of: youdoogo
spec:
  serviceName: youdoogo-minio
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: youdoogo-minio
  template:
    metadata:
      labels:
        app.kubernetes.io/name: youdoogo-minio
        app.kubernetes.io/part-of: youdoogo
    spec:
      terminationGracePeriodSeconds: 30
      containers:
        - name: minio
          image: minio/minio:RELEASE.2025-04-22T22-12-26Z
          imagePullPolicy: IfNotPresent
          args: ["server", "/data"]
          env:
            - name: MINIO_ROOT_USER
              valueFrom:
                secretKeyRef:
                  name: youdoogo-runtime
                  key: MINIO_ACCESS_KEY
            - name: MINIO_ROOT_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: youdoogo-runtime
                  key: MINIO_SECRET_KEY
          ports:
            - name: api
              containerPort: 9000
          readinessProbe:
            httpGet: {path: /minio/health/ready, port: api}
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 12
          livenessProbe:
            httpGet: {path: /minio/health/live, port: api}
            periodSeconds: 20
            timeoutSeconds: 3
            failureThreshold: 3
          resources:
            requests: {cpu: 100m, memory: 256Mi}
            limits: {cpu: "1", memory: 1Gi}
          volumeMounts:
            - name: data
              mountPath: /data
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        accessModes: ["ReadWriteOnce"]
        storageClassName: csi-disk
        resources:
          requests:
            storage: 20Gi
