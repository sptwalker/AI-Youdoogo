# ===== 应用 =====
APP_ENV=local
LOG_LEVEL=INFO
API_PORT=8000
JWT_SECRET=local-only-jwt-secret-change-in-production

# ===== 数据库（timescale/timescaledb-ha:pg16，内置 pgvector + timescaledb）=====
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/youdoo
# 若本机已装原生 PostgreSQL 占用 5432（localhost 会命中原生库导致连接被关闭），
# 把容器映射到空闲端口并同步 DATABASE_URL，例如：
#   POSTGRES_PORT=5433
#   DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/youdoo

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Durable workflow worker（PostgreSQL outbox）=====
WORKFLOW_WORKER_ENABLED=true
WORKFLOW_WORKER_POLL_SECONDS=1.0
WORKFLOW_EVENT_LEASE_SECONDS=300
WORKFLOW_STEP_LEASE_SECONDS=600
WORKFLOW_RETRY_DELAY_SECONDS=5
WORKFLOW_RECOVERY_SCAN_SECONDS=30
WORKFLOW_RECOVERY_BATCH_SIZE=100

# ===== MinIO =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=youdoo
# 本地保持 false；生产启用 TLS 后改 true，并确保运行环境信任 MinIO 证书链
MINIO_SECURE=false
# 逗号分隔。空 bucket allowlist 仅允许 MINIO_BUCKET；空 prefix 保持旧路径全量访问
MINIO_ALLOWED_BUCKETS=
MINIO_ALLOWED_PREFIXES=
MINIO_PRESIGN_EXPIRE_SECONDS=900

# ===== 内部服务身份（物理拆分前置，当前默认关闭且未接入 HTTP）=====
INTERNAL_JWT_ENABLED=false
INTERNAL_JWT_ISSUER=
INTERNAL_JWT_AUDIENCE=
INTERNAL_JWT_SERVICE_ID=
# 仅通过部署密钥注入；不要把真实 PEM 写入或提交到 .env/.env.example
INTERNAL_JWT_PRIVATE_KEY=
INTERNAL_JWT_PUBLIC_KEY=
# 强制 1~300 秒；与现有用户 JWT_SECRET/JWT 互不复用
INTERNAL_JWT_TTL_SECONDS=300

# ===== 大模型（国产为主，DeepSeek 主力；密钥只放 .env，禁止硬编码）=====
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
ANTHROPIC_API_KEY=
# LLM 当日 token 预算，超阈值告警（0=不启用）
LLM_DAILY_TOKEN_BUDGET=0

# ===== Embedding（知识库向量化，A/B 可配置；留空用通义 text-embedding-v3 / 1024维）=====
# 换 bge-m3 等：填 OpenAI 兼容 /embeddings 端点根地址 + 模型名 + 密钥（须仍 1024 维）
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_API_KEY=

# ===== 飞书（企业自建应用）=====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 飞书登录默认关闭；启用前必须配置下方回调并在飞书开放平台登记完全相同的 URL
FEISHU_OAUTH_ENABLED=false
# 本地 Vite 联调：http://localhost:5173/api/v1/auth/feishu/callback（浏览器也须用 localhost）
# 生产值：https://<你的域名>/api/v1/auth/feishu/callback（必须为 HTTPS）
FEISHU_REDIRECT_URL=
FEISHU_NOTIFY_ENABLED=false
FEISHU_OPS_CHAT_ID=

# ===== ThinkingData 运营数据平台（docs/11 附录B）=====
TD_BASE_URL=
TD_API_SECRET=
