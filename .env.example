# ===== 应用 =====
APP_ENV=local
LOG_LEVEL=INFO
API_PORT=8000
JWT_SECRET=change-me-in-phase-1

# ===== 数据库（timescale/timescaledb-ha:pg16，内置 pgvector + timescaledb）=====
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/youdoo

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== MinIO =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=youdoo

# ===== 大模型（国产为主，DeepSeek 主力；密钥只放 .env，禁止硬编码）=====
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
ANTHROPIC_API_KEY=

# ===== 飞书（企业自建应用）=====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_NOTIFY_ENABLED=false
